# Configuration for AutoVPN script
# Rename this file to .env and replace the placeholders with your actual credentials and paths.

# VPN server hostname (e.g. vpn.ethz.ch)
VPN_HOST=sslvpn.ethz.ch

# Your ETH username
VPN_USER=

# Your ETH password (do NOT include your OTP here)
VPN_PASS=

# Base32-encoded TOTP secret used to generate the one-time passwords.
OTP_SECRET=

# Path to the Cisco Secure Client CLI executable (vpncli.exe). If the
# binary is in your PATH you can leave this empty.
CISCO_CLI_PATH=C:\Program Files (x86)\Cisco\Cisco Secure Client\vpncli.exe

CISCO_UI_PATH=C:\Program Files (x86)\Cisco\Cisco Secure Client\UI\csc_ui.exe
